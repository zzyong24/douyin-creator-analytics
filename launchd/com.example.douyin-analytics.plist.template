<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__MODULE_DIR__/launchd/run-scheduled.sh</string></array>
  <key>WorkingDirectory</key><string>__MODULE_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DOUYIN_ANALYTICS_HOME</key><string>__RUNTIME_HOME__</string>
    <key>DOUYIN_EXPECTED_NICKNAME</key><string>__EXPECTED_NICKNAME__</string>
    <key>DOUYIN_ANALYTICS_LABEL</key><string>__LABEL__</string>
    <key>ANALYTICS_NODE_BIN</key><string>__NODE_BIN__</string>
    <key>EGO_USER_DATA_DIR</key><string>__EGO_USER_DATA_DIR__</string>
    <key>EGO_EXECUTABLE</key><string>__EGO_EXECUTABLE__</string>
  </dict>
  <key>StartInterval</key><integer>21600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__RUNTIME_HOME__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__RUNTIME_HOME__/logs/launchd.err.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
